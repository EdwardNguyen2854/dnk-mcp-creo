{
  "name": "dnk-mcp-creo-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "DNK MCP Creo - Model Context Protocol server for PTC Creo Parametric, built on an asynchronous Object TOOLKIT C++ bridge",
  "license": "Apache-2.0",
  "author": {
    "name": "Edward Nguyen",
    "url": "https://github.com/EdwardNguyen2854"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdwardNguyen2854/dnk-mcp-creo.git"
  },
  "homepage": "https://github.com/EdwardNguyen2854/dnk-mcp-creo#readme",
  "bugs": {
    "url": "https://github.com/EdwardNguyen2854/dnk-mcp-creo/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ptc-creo",
    "creo-parametric",
    "pro-toolkit",
    "object-toolkit",
    "cad",
    "automation"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace dnk-mcp-creo",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dev": "npm run dev --workspace dnk-mcp-creo",
    "doctor": "node packages/server/dist/cli/doctor.js",
    "doctor:mock": "node packages/server/dist/cli/doctor.js --mock",
    "test": "npm run test --workspace dnk-mcp-creo",
    "typecheck": "npm run typecheck --workspace dnk-mcp-creo",
    "verify": "npm run typecheck && npm test && npm run build"
  }
}
