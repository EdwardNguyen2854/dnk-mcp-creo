{
  "name": "dnk-mcp-creo",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server exposing PTC Creo Parametric through the creo-otk-bridge",
  "license": "Apache-2.0",
  "author": {
    "name": "Edward Nguyen",
    "url": "https://github.com/EdwardNguyen2854"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdwardNguyen2854/dnk-mcp-creo.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/EdwardNguyen2854/dnk-mcp-creo#readme",
  "bugs": {
    "url": "https://github.com/EdwardNguyen2854/dnk-mcp-creo/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ptc-creo",
    "creo-parametric",
    "pro-toolkit",
    "object-toolkit",
    "cad",
    "automation"
  ],
  "type": "module",
  "bin": {
    "dnk-mcp-creo": "dist/index.js",
    "dnk-mcp-creo-doctor": "dist/cli/doctor.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "doctor": "node dist/cli/doctor.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
